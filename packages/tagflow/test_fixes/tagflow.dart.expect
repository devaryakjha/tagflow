// Fix tests for lib/fix_data.yaml. Each call below has its migrated form in
// tagflow.dart.expect; run `dart fix --compare-to-golden` in this folder.

import 'package:flutter/widgets.dart' hide ErrorWidgetBuilder;
import 'package:tagflow/tagflow.dart';

void main() {
  // Changes made in 1.0.0-beta.1.

  // Default constructor.
  const Tagflow.html(html: '<p>Hello</p>');
  Tagflow.html(html: '<p>Hello</p>', key: UniqueKey());
  Tagflow.html(html: '<p>Hello</p>', viewOptions: const TagflowViewOptions(debug: true));

  // options: parameters.
  Tagflow.html(
    html: '<p>Hello</p>',
    viewOptions: const TagflowViewOptions(enableImageCache: false),
  );
  Tagflow.document(
    TagflowDocument(id: 'doc', children: const []),
    viewOptions: const TagflowViewOptions(),
  );
  const TagflowHtmlAdapter().parse(
    '<p>Hello</p>',
    viewOptions: const TagflowViewOptions(maxImageWidth: 320),
  );

  // An options variable migrates along with its initializer.
  final options = TagflowViewOptions(linkTapCallback: (url, attributes) {});
  Tagflow.html(html: '<p>Hello</p>', viewOptions: options);

  // TagflowScope.
  TagflowScope.view(viewOptions: options, child: const SizedBox());

  // renderBoundary has no TagflowViewOptions equivalent, so this call is left
  // for a manual migration.
  const TagflowOptions(
    renderBoundary: TagflowRenderBoundary.comment(start: 'start'),
  );

  // ErrorWidgetBuilder.
  TagflowErrorWidgetBuilder? errorBuilder;
  Tagflow.html(html: '<p>Hello</p>', errorBuilder: errorBuilder!);
}
